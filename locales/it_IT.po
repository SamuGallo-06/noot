#: src/main.py:603
msgid "Backing up"
msgstr "Eseguo backup"

#: src/main.py:630
msgid "Backup completed successfully."
msgstr "Backup completato con successo."

#: src/main.py:632
msgid "Restore a local backup onto the connected device."
msgstr "Ripristina un backup locale sul dispositivo connesso."

#: src/main.py:640
msgid ""
"Target iOS device UDID (the device connected now, that will receive the "
"restore)."
msgstr ""
"UDID del dispositivo iOS di destinazione (il dispositivo connesso che riceverà il ripristino)."

#: src/main.py:641 src/main.py:783 src/main.py:840 src/main.py:925
#: src/main.py:953
msgid "Enter device UDID"
msgstr "Inserisci l'UDID del dispositivo"

#: src/main.py:650
msgid ""
"UDID of the backup to restore, if different from the target device. Defaults "
"to the target device's own UDID (restore its own latest backup). Use 'noot "
"list-backups' to see what's available."
msgstr ""
"UDID del backup da ripristinare, se diverso dal dispositivo di destinazione. "
"Il valore predefinito corrisponde all'UDID del dispositivo stesso (ripristina l'ultimo backup). "
"Usa 'noot list-backups' per visualizzare i backup disponibili."

#: src/main.py:669
msgid ""
"Remove data on the device that isn't present in the backup (mirror restore). "
"Default: keep extra data untouched."
msgstr ""
"Rimuovi i dati sul dispositivo non presenti nel backup (ripristino speculare). "
"Predefinito: lascia invariati i dati aggiuntivi."

#: src/main.py:689
msgid "Restore backup"
msgstr "Ripristina backup"

#: src/main.py:690
#, python-brace-format
msgid "Target device: {udid}"
msgstr "Dispositivo di destinazione: {udid}"

#: src/main.py:693
#, python-brace-format
msgid ""
"⚠ You are restoring a backup from a DIFFERENT device ({source}) onto this "
"one ({udid})."
msgstr ""
"⚠ Stai ripristinando il backup di un dispositivo DIVERSO ({source}) su questo ({udid})."

#: src/main.py:698
#, python-brace-format
msgid "Backup source: {source} (same as target)"
msgstr "Sorgente backup: {source} (uguale alla destinazione)"

#: src/main.py:699
#, python-brace-format
msgid "Backup location: {dir}"
msgstr "Posizione del backup: {dir}"

#: src/main.py:702
msgid ""
"\n"
"Restoring will overwrite existing data on the target device with the "
"contents of this backup. This cannot be undone."
msgstr ""
"\n"
"Il ripristino sovrascriverà i dati esistenti sul dispositivo con il contenuto "
"di questo backup. Questa operazione non può essere annullata."

#: src/main.py:707
msgid ""
"⚠ --remove-extra-data is enabled: any data on the device NOT present in this "
"backup will also be deleted."
msgstr ""
"⚠ L'opzione --remove-extra-data è attiva: qualsiasi dato sul dispositivo NON presente "
"in questo backup verrà cancellato."

#: src/main.py:711
msgid "Do you want to continue?"
msgstr "Vuoi continuare?"

#: src/main.py:714
msgid ""
"The device will restart automatically once the restore is complete. Keep it "
"connected until then."
msgstr ""
"Il dispositivo si riavvierà automaticamente al termine del ripristino. "
"Tienilo collegato fino alla conclusione dell'operazione."

#: src/main.py:723
#, python-brace-format
