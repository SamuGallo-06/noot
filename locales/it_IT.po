msgstr "Errore: nessun backup trovato per '{source}' in {dir}."

#: src/main.py:725
msgid "Available backups:"
msgstr "Backup disponibili:"

#: src/main.py:731
msgid "Backup password (leave blank if not encrypted): "
msgstr "Password del backup (lascia vuoto se non cifrato): "

#: src/main.py:734
msgid ""
"\n"
"For safety reasons, please confirm you want to restore this device from a "
"backup."
msgstr ""
"\n"
"Per motivi di sicurezza, conferma di voler ripristinare questo dispositivo da un backup."

#: src/main.py:738
#, python-brace-format
msgid "Type the device UDID ({udid}) to confirm the restore"
msgstr "Digita l'UDID del dispositivo ({udid}) per confermare il ripristino"

#: src/main.py:740
msgid "UDID does not match. Restore cancelled."
msgstr "L'UDID non corrisponde. Ripristino annullato."

#: src/main.py:745
msgid "Restoring backup"
msgstr "Ripristino del backup in corso"

#: src/main.py:772
msgid "Backup restored successfully."
msgstr "Backup ripristinato con successo."

#: src/main.py:774
msgid "Delete a local backup for the specified device UDID."
msgstr "Elimina un backup locale per l'UDID specificato."

#: src/main.py:782 src/main.py:839 src/main.py:924 src/main.py:952
msgid "Target iOS device UDID"
msgstr "UDID del dispositivo iOS di destinazione"

#: src/main.py:802
#, python-brace-format
msgid "No backup found for UDID {udid} in {dir}."
msgstr "Nessun backup trovato per l'UDID {udid} in {dir}."

#: src/main.py:806
#, python-brace-format
msgid ""
"Are you sure you want to delete the backup for device '{name}' (UDID: "
"{udid})?"
msgstr ""
"Sei sicuro di voler eliminare il backup per il dispositivo '{name}' (UDID: {udid})?"

#: src/main.py:809
msgid "This action cannot be undone. Continue?"
msgstr "Questa azione non può essere annullata. Continuare?"

#: src/main.py:821
#, python-brace-format
msgid "Backup for UDID {udid} deleted successfully."
msgstr "Backup per l'UDID {udid} eliminato con successo."

#: src/main.py:823
#, python-brace-format
